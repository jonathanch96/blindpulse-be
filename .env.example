APP_ENV=local
APP_PORT=8080
APP_SHUTDOWN_TIMEOUT=15s

DB_HOST=localhost
DB_PORT=5432
POSTGRES_HOST_PORT=5432
DB_USER=blindpulse
DB_PASSWORD=blindpulse
DB_NAME=blindpulse
DB_SCHEMA=blindpulse
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_AUTO_MIGRATE=false

JWT_ACCESS_SECRET=local-access-secret-change-me-32-bytes
JWT_REFRESH_SECRET=local-refresh-secret-change-me-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# OAuth client ID from Google Cloud Console (Credentials > OAuth 2.0 Client IDs). Must match the
# GOOGLE_CLIENT_ID the frontend requests ID tokens with. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Journal screenshots and exported session reports. Leave STORAGE_ENDPOINT empty to use signed
# local-filesystem storage instead of MinIO/S3.
STORAGE_LOCAL_ROOT=./var/journal
STORAGE_PUBLIC_URL=http://localhost:8080/api/v1/journal-media
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=blindpulse-journal
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false

# Redis backs the replay hot path. Empty REDIS_ADDR runs single-instance with in-process state -
# fine for a laptop, not for more than one API replica.
REDIS_ADDR=localhost:6379
REDIS_HOST_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_NAMESPACE=blindpulse
REDIS_DIAL_TIMEOUT=3s
REDIS_READ_TIMEOUT=2s
REDIS_POOL_SIZE=20
REDIS_SESSION_TTL=12h
REDIS_BAR_WINDOW_TTL=1h

# Kafka carries the event spine. Empty KAFKA_BROKERS leaves events queued in the outbox; nothing
# is lost, publication just waits for a broker.
KAFKA_BROKERS=localhost:9092
KAFKA_HOST_PORT=9092
KAFKA_TOPIC_PREFIX=blindpulse
KAFKA_CONSUMER_GROUP=blindpulse-projectors
KAFKA_CLIENT_ID=blindpulse-api
KAFKA_BATCH_SIZE=100
KAFKA_BATCH_TIMEOUT=200ms
KAFKA_WRITE_TIMEOUT=5s
KAFKA_RELAY_INTERVAL=1s
KAFKA_RELAY_BATCH=200
KAFKA_MAX_ATTEMPTS=8

# Server-side mirrors of the terminal's risk gates and playback bounds. These are authoritative:
# the UI copy is a convenience, this is what the order gate enforces.
REPLAY_MIN_SPEED=0.5
REPLAY_MAX_SPEED=10
REPLAY_MAX_OPEN_POSITIONS=10
REPLAY_MIN_RISK_REWARD=2
REPLAY_MAX_DAILY_DRAWDOWN_PCT=5
REPLAY_BAR_WINDOW_SIZE=1500
REPLAY_STREAM_TICK_INTERVAL=250ms
REPLAY_SESSION_IDLE_TIMEOUT=30m
